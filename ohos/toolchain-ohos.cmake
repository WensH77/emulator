set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(OHOS_SDK /Applications/DevEco-Studio.app/Contents/sdk/default/openharmony)
set(CMAKE_C_COMPILER   ${OHOS_SDK}/native/llvm/bin/clang)
set(CMAKE_CXX_COMPILER ${OHOS_SDK}/native/llvm/bin/clang++)
set(CMAKE_AR           ${OHOS_SDK}/native/llvm/bin/llvm-ar)
set(CMAKE_RANLIB       ${OHOS_SDK}/native/llvm/bin/llvm-ranlib)
set(CMAKE_C_FLAGS_INIT   "--target=aarch64-linux-ohos --sysroot=${OHOS_SDK}/native/sysroot -fPIC")
set(CMAKE_CXX_FLAGS_INIT "--target=aarch64-linux-ohos --sysroot=${OHOS_SDK}/native/sysroot -fPIC")
set(CMAKE_EXE_LINKER_FLAGS_INIT    "--target=aarch64-linux-ohos --sysroot=${OHOS_SDK}/native/sysroot")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "--target=aarch64-linux-ohos --sysroot=${OHOS_SDK}/native/sysroot")
set(CMAKE_ASM_FLAGS_INIT "--target=aarch64-linux-ohos --sysroot=${OHOS_SDK}/native/sysroot -fPIC")
